border-radius=3.0
customize-label=false
customize-topbar=true
dock-location=1
dock-padding=0.0
edge-distance=0.25555555555555554
icon-border-radius=3.0
icon-effect-color=(1.0, 1.0, 1.0, 1.0)
icon-shadow=true
icon-size=0.1206896551724138
icon-spacing=0.11618257261410789
items-pullout-angle=0.5
label-border-radius=0.0
mounted-icon=true
msg-to-ext=''
overview-transparent-background=false
panel-mode=false
preferred-monitor=0
pressure-sense=false
pressure-sense-sensitivity=0.40000000000000002
running-indicator-size=2
running-indicator-style=1
scroll-sensitivity=0.40000000000000002
separator-thickness=0
shrink-icons=true

[just-perfection]
panel-in-overview=true
support-notifier-type=0
window-demands-attention-focus=true

[multi-monitors-add-on]
available-indicators=['clipboardIndicator']

[multi-monitors-bar]
available-indicators=['clipboardIndicator', 'system-monitor']
screenshot-on-all-monitors=true

[nightthemeswitcher/commands]
enabled=false

[nightthemeswitcher/time]
location=(53.04716993653652, 11.074999999999999)
manual-schedule=false
nightthemeswitcher-ondemand-keybinding=['']
sunrise=6.4673136621777161
sunset=20.17623771511964

