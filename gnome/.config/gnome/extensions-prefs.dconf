[clipboard-indicator]
excluded-apps=['KeePass']
history-size=30
keep-selected-on-clear=true
move-item-first=true
pinned-on-bottom=true
strip-text=true

[dash-to-dock]
always-center-icons=true
animation-time=0.10000000000000002
autohide=true
autohide-in-fullscreen=true
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=40
disable-overview-on-startup=true
dock-fixed=true
dock-position='LEFT'
extend-height=true
height-fraction=0.40000000000000002
hide-delay=0.10000000000000002
intellihide=true
intellihide-mode='ALL_WINDOWS'
max-alpha=0.80000000000000004
multi-monitor=true
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
pressure-threshold=100.0
require-pressure-to-show=false
running-indicator-style='DOTS'
show-delay=1.3877787807814457e-17
show-dock-urgent-notify=true
show-mounts-network=true
transparency-mode='DYNAMIC'

[dash2dock-lite]
animate-icons-unmute=true
animation-bounce-height=0.75
animation-magnify=0.29999999999999999
animation-rise=0.25
animation-spread=0.75
apps-icon-front=false
autohide-dash=false
